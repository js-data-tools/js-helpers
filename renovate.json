{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Automerge non-breaking dependency updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Wait 30 days before proposing major dependency updates",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days",
      "internalChecksFilter": "strict",
      "automerge": false
    },
    {
      "description": "Skip TypeScript 7.0.x until ESLint compatibility is restored",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7.0.0 || >=7.1.0"
    }
  ]
}
